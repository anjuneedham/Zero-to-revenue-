# Copy to .env (gitignored). Never put a private key, seed phrase,
# recovery phrase, password or 2FA code in this file or anywhere else.

# Database (Phase 1)
# Postgres (Neon via Vercel sets this automatically in Vercel; never paste it into git/chat).
# For local runs: `vercel env pull` or point at a local throwaway Postgres.
DATABASE_URL=
# Tests only: a THROWAWAY database. Never the production DATABASE_URL.
TEST_DATABASE_URL=

# PayPal (receiving payments only). PAYPAL_MODE=sandbox or live.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Owner-only login lives in Postgres (password + authenticator app). One-time setup:
# set a random 20+ character OWNER_SETUP_TOKEN in the host (Vercel env), open the app, finish
# setup, then DELETE this variable. Never commit it or paste it in chat.
OWNER_SETUP_TOKEN=

# AI provider: Claude (Anthropic API). Key goes in .env / host secret store only.
ANTHROPIC_API_KEY=
# Monthly spend cap in USD that the system must not exceed (spec section 39).
LLM_MONTHLY_BUDGET_USD=80
# USD per million tokens from the provider's pricing page. Claude stays DISABLED until both are set.
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=
CLAUDE_MODEL=claude-sonnet-5-5

# Notifications: WhatsApp (owner's number, E.164). Backend defaults to MOCK.
WHATSAPP_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=

# Financial safety flags are hard-coded in core/policy/policy.py and are
# intentionally NOT configurable here.

# Read-only Claude connector (MCP). 32+ random characters. The connector URL is
# https://<your-domain>/mcp/<this token>: treat it like a password.
MCP_CONNECTOR_TOKEN=
