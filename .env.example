# Copy to .env (gitignored). Never put a private key, seed phrase,
# recovery phrase, password or 2FA code in this file or anywhere else.

# Public receiving address only (read-only monitoring).
OWNER_WALLET_ADDRESS=0x99024726DF6dB68c8a38f20e320f08e83d701ab6
# REQUIRED: the chain must be set explicitly. A 0x address does not imply
# Ethereum mainnet. Treasury refuses to run until this is set.
OWNER_WALLET_CHAIN_ID=

# Database (Phase 1)
DATABASE_URL=sqlite:///./zero_to_revenue.db

# Read-only RPC endpoint for the configured chain (Phase 4)
WALLET_RPC_URL=

# Owner-only login (Firebase Auth). Only this verified email can sign in.
OWNER_EMAIL=
FIREBASE_PROJECT_ID=

# AI provider: Claude (Anthropic API). Key goes in .env / host secret store only.
ANTHROPIC_API_KEY=
# Monthly spend cap in USD that the system must not exceed (spec section 39).
LLM_MONTHLY_BUDGET_USD=

# Notifications: WhatsApp (owner's number, E.164). Backend defaults to MOCK.
WHATSAPP_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=

# Financial safety flags are hard-coded in core/policy/policy.py and are
# intentionally NOT configurable here.
